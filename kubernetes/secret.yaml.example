apiVersion: v1
kind: Secret
metadata:
  name: cortex-secrets
  namespace: cortex-system
type: Opaque
stringData:
  # Base security credentials (REQUIRED in production)
  SECRET_KEY: "replace-with-a-random-32-character-secret-key"
  ADMIN_USERNAME: "admin"
  ADMIN_PASSWORD: "replace-with-a-strong-admin-password"
  CORTEX_ENCLAVE_MASTER_KEY: "replace-with-32-byte-base64-master-key"

  # Managed Database & Cache URLs
  DATABASE_URL: "postgresql://cortex:cortex-pass@postgres-svc.cortex-system:5432/cortex"
  REDIS_URL: "redis://redis-svc.cortex-system:6379/0"

  # Webhook Shared Authentication Tokens (Fail-closed in production)
  GITHUB_WEBHOOK_SECRET: "your-github-webhook-secret"
  JENKINS_WEBHOOK_SECRET: "your-jenkins-webhook-secret"
  ALERTMANAGER_TOKEN: "your-alertmanager-bearer-token"

  # External CI/CD and Observability Endpoints
  JENKINS_URL: "http://jenkins-svc.cortex-system:8080"
  PROMETHEUS_URL: "http://prometheus-svc.cortex-system:9090"

