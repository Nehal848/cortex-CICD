# CortexCICD Environment Configuration Example
# Copy this file to .env and fill in real credentials before deploying.

# Flask & Security
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
SESSION_COOKIE_SECURE=false

# Programmatic API Token (optional static token; users can also generate per-user tokens at /settings)
CORTEX_API_TOKEN=

# Database (leave blank for local SQLite at app/cortex.db; set for PostgreSQL)
# Example: postgresql://cortex:cortex@postgres:5432/cortex
DATABASE_URL=

# Redis Pub/Sub for distributed SSE events across API & Worker containers
# Example: redis://redis:6379/0
REDIS_URL=

# Set true on cortex-api containers when cortex-worker runs separately
DISABLE_EMBEDDED_WORKER=false

# Webhook Signature Verification (required in FLASK_ENV=production)
GITHUB_WEBHOOK_SECRET=
JENKINS_WEBHOOK_SECRET=
ALERTMANAGER_TOKEN=
STRICT_WEBHOOK_VERIFICATION=false
TRUSTED_PROXY_COUNT=0

# External Integrations
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=
PROMETHEUS_URL=http://localhost:9090
K8S_NAMESPACE=default

# Trusted Execution Environment (TEE) Sealing Key
CORTEX_ENCLAVE_MASTER_KEY=
TEE_MODE=simulated

# Notifications (Slack Webhook + SMTP)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cortex@example.com
ALERT_EMAIL_TO=

