FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Workers need docker CLI to spin up sandbox environments for testing patches
RUN apt-get update && apt-get install -y --no-install-recommends \
        docker.io \
        git \
        curl \
        ca-certificates \
    && \
    # Syft (SBOM generator — may also be invoked from worker)
    curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh \
        | sh -s -- -b /usr/local/bin v1.14.0 && \
    rm -rf /var/lib/apt/lists/*

# Create dedicated non-root service account with docker group access
RUN groupadd -r cortex && useradd -r -g cortex -G docker -d /app -s /sbin/nologin cortex

COPY . .
RUN chown -R cortex:cortex /app

USER cortex

# Start the Celery or RQ worker
CMD ["python", "worker.py"]
