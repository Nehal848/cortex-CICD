FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create dedicated non-root service account
RUN groupadd -r cortex && useradd -r -g cortex -d /app -s /sbin/nologin cortex

COPY . .
RUN chown -R cortex:cortex /app

USER cortex

# Cortex API runs on 5000 via multi-threaded Gunicorn (supports persistent SSE streams)
EXPOSE 5000

CMD ["gunicorn", "--worker-class", "gthread", "--threads", "4", "--workers", "2", "--timeout", "120", "-b", "0.0.0.0:5000", "wsgi:application"]
